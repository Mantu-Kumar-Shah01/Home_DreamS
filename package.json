{
  "homepage": "https://mantu-kumar0/.github.io/Home_DreamS",
  "name": "find-home",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "npx @tailwindcss/cli -i ./src/input.css -o ./src/output.css && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tail": "npx @tailwindcss/cli -i ./src/input.css -o ./src/output.css --watch",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "deploy:cloudflare": "npm run build && npx wrangler pages deploy dist --project-name=home-dreams",
    "deploy:worker": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.13",
    "framer-motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-toastify": "^11.0.5",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "gh-pages": "^6.3.0",
    "globals": "^16.3.0",
    "vite": "^7.1.2"
  }
}
